# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# anchor / solana
# target/ holds the build artefacts and the program keypair. The keypair is the
# upgrade authority for DeadwBH8o2uqPTpdA5LDHmz6i7dv8LGtFFtmytKyxZ5F, so it stays
# out of the repo; the program id itself is public and lives in Anchor.toml.
target
.anchor
**/*.rs.bk
test-ledger
.surfpool
